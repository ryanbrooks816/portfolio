---
import Navigation from "../components/Navigation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Access Request | Portfolio">
  <Navigation />
  <div class="max-w-lg mx-auto py-12 px-4">
    <div class="mb-8 text-center">
      <h1 class="text-4xl font-bold leading-tight tracking-tight text-slate-900 dark:text-neutral-100 lg:text-5xl">
        Unlock Access
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-neutral-300">
        Please enter your access code to view private projects and case studies.
      </p>
    </div>

    <div
      class="rounded-xl border border-slate-200 dark:border-neutral-800 bg-white dark:bg-neutral-950/90 shadow-sm p-8"
    >
      <form id="access-form" class="space-y-6">
        <div>
          <label for="access-code" class="block text-sm font-medium text-slate-700 dark:text-neutral-300 mb-2">
            Access Code
          </label>
          <input
            type="text"
            id="access-code"
            name="accessCode"
            required
            class="w-full px-4 py-3 bg-slate-50 dark:bg-neutral-900 border border-slate-300 dark:border-neutral-700 rounded-md text-slate-900 dark:text-neutral-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-neutral-500 focus:border-transparent transition-colors"
            autocomplete="off"
            autocapitalize="characters"
            placeholder="Enter your access code here"
            style="text-transform: uppercase;"
          />
        </div>

        <div
          id="error-message"
          role="alert"
          class="hidden bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded-md"
        >
          <p class="text-sm"></p>
        </div>

        <div
          id="success-message"
          role="status"
          class="hidden bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded-md"
        >
          <p class="text-sm">Access granted! Redirecting...</p>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-4 rounded-md focus:outline-none focus:ring-2 focus:ring-neutral-500 focus:ring-offset-2 focus:ring-offset-white dark:bg-neutral-200 dark:text-neutral-950 dark:hover:bg-white dark:focus:ring-offset-neutral-950 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Submit
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-slate-100 dark:border-neutral-800">
        <h3 class="text-sm font-semibold text-slate-700 dark:text-neutral-300 mb-2">Need an access code?</h3>
        <p class="text-xs text-slate-500 dark:text-neutral-400">
          To protect client information and live projects, a password is required. Please refer to the top of my resume
          for the current access code, or contact me and I'll be happy to provide one.
        </p>
      </div>
    </div>
  </div>

  <script>
    document.getElementById("access-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
      const errorMessage = document.getElementById("error-message") as HTMLElement | null;
      const successMessage = document.getElementById("success-message") as HTMLElement | null;
      const accessCodeInput = document.getElementById("access-code") as HTMLInputElement | null;

      const accessCode = accessCodeInput?.value.trim().toUpperCase() ?? "";

      errorMessage?.classList.add("hidden");
      successMessage?.classList.add("hidden");

      if (submitBtn) {
        submitBtn.textContent = "Verifying...";
        submitBtn.disabled = true;
      }

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15000);
      let redirecting = false;

      try {
        const response = await fetch("/api/access/verify", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ accessCode }),
          signal: controller.signal,
        });

        const result = (await response.json()) as {
          success?: boolean;
          message?: string;
        };

        if (response.ok && result.success) {
          redirecting = true;
          successMessage?.classList.remove("hidden");

          const urlParams = new URLSearchParams(window.location.search);
          const requestedRedirect = urlParams.get("redirect");
          let redirectTo = "/projects";

          if (
            requestedRedirect?.startsWith("/") &&
            !requestedRedirect.startsWith("//") &&
            !requestedRedirect.includes("\\")
          ) {
            const target = new URL(requestedRedirect, window.location.origin);

            if (target.origin === window.location.origin) {
              redirectTo = target.pathname + target.search + target.hash;
            }
          }

          window.setTimeout(() => {
            window.location.assign(redirectTo);
          }, 750);
        } else {
          const errorText = errorMessage?.querySelector("p");

          if (errorText) {
            errorText.textContent =
              response.status >= 500
                ? "The verification service is temporarily unavailable. Please try again."
                : result.message || "Invalid access code. Please try again.";
          }

          errorMessage?.classList.remove("hidden");
        }
      } catch (error) {
        const errorText = errorMessage?.querySelector("p");

        if (errorText) {
          errorText.textContent =
            error instanceof DOMException && error.name === "AbortError"
              ? "The verification service took too long to respond. Please try again."
              : "Unable to verify your access code. Please try again.";
        }

        errorMessage?.classList.remove("hidden");
      } finally {
        window.clearTimeout(timeout);

        if (submitBtn && !redirecting) {
          submitBtn.textContent = "Submit";
          submitBtn.disabled = false;
        }
      }
    });
  </script>
</BaseLayout>

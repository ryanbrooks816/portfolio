---
import Navigation from "../components/Navigation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Access Request | Portfolio">
  <Navigation />
  <div class="max-w-lg mx-auto py-12 px-4">
    <div class="mb-8 text-center">
      <h1 class="ui-heading-hero">Unlock Access</h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300">
        Please enter the access code from my resume to view private projects and case studies.
      </p>
    </div>
    <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900/80 shadow-sm p-8">
      <form id="access-form" class="space-y-6">
        <div>
          <label for="access-code" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
            Access Code
          </label>
          <input
            type="text"
            id="access-code"
            name="accessCode"
            required
            class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors"
            autocomplete="off"
            placeholder="Enter your access code here"
            style="text-transform: uppercase;"
          />
        </div>

        <div
          id="error-message"
          class="hidden bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 px-4 py-3 rounded-md"
        >
          <p class="text-sm"></p>
        </div>

        <div
          id="success-message"
          class="hidden bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded-md"
        >
          <p class="text-sm">Access granted! Redirecting...</p>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-4 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-slate-900 transition-colors"
        >
          Submit
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-700">
        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Need an access code?</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          To protect client information and live projects, a password is required. Please refer to the top of my resume
          for the current access code, or contact me and I'll be happy to provide one.
        </p>
      </div>
    </div>
  </div>

  <script>
    document.getElementById("access-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
      const errorMessage = document.getElementById("error-message") as HTMLElement | null;
      const successMessage = document.getElementById("success-message") as HTMLElement | null;
      const accessCodeInput = document.getElementById("access-code") as HTMLInputElement | null;
      let accessCode = accessCodeInput ? accessCodeInput.value : "";
      accessCode = accessCode.toUpperCase();
      errorMessage?.classList.add("hidden");
      successMessage?.classList.add("hidden");
      if (submitBtn) {
        submitBtn.textContent = "Verifying...";
        submitBtn.disabled = true;
      }
      try {
        const response = await fetch("/api/access/verify", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ accessCode }),
        });
        const result = await response.json();
        if (response.ok && result.success) {
          successMessage?.classList.remove("hidden");
          const urlParams = new URLSearchParams(window.location.search);
          const redirectTo = urlParams.get("redirect") || "/projects";
          setTimeout(() => {
            window.location.href = redirectTo;
          }, 1500);
        } else {
          const errorText = errorMessage?.querySelector("p");
          if (errorText) errorText.textContent = result.message || "Invalid access code. Please try again.";
          errorMessage?.classList.remove("hidden");
        }
      } catch (error) {
        const errorText = errorMessage?.querySelector("p");
        if (errorText) errorText.textContent = "Network error. Please try again.";
        errorMessage?.classList.remove("hidden");
      } finally {
        if (submitBtn) {
          submitBtn.textContent = "Request Access";
          submitBtn.disabled = false;
        }
      }
    });
  </script>
</BaseLayout>

---
import { projects } from "../../data/content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import PasswordGate from "../../components/PasswordGate.astro";

import type { Project } from "../../types";

export async function getStaticPaths() {
  return projects.map((p: Project) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project: Project | undefined = projects.find((p: Project) => p.slug === slug);
---

<BaseLayout title={`${project ? project.title : "Project Not Found"} | Portfolio`}>
  {
    project ? (
      <article class="py-8">
        <h2 class="text-3xl font-bold">{project.title}</h2>
        <p class="mt-3 text-slate-300">{project.description}</p>

        <div class="mt-6">
          <h3 class="text-sm uppercase text-slate-400">Tags</h3>
          <div class="flex gap-2 mt-2">
            {project.tags.map((t) => (
              <span class="px-2 py-1 text-xs rounded bg-slate-800/40">{t}</span>
            ))}
          </div>
        </div>

        <div class="mt-8">
          {project.private ? (
            <PasswordGate projectSlug={project.slug} projectTitle={project.title} />
          ) : (
            <div class="mt-6">
              <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="prose prose-invert text-slate-200">
                  <h4>Overview</h4>
                  <p>This public project includes a demo link and repository information below.</p>
                  <p class="mt-4">
                    <a class="text-indigo-400" href="#">
                      View demo
                    </a>{" "}
                    ·{" "}
                    <a class="text-indigo-400" href="#">
                      Repository
                    </a>
                  </p>
                </div>

                <div class="p-4 rounded-md glass">
                  <h5 class="text-sm text-slate-300">Tech stack</h5>
                  <div class="flex flex-wrap gap-2 mt-2">
                    {project.tags.map((t) => (
                      <span class="px-2 py-1 text-xs rounded bg-slate-800/40">{t}</span>
                    ))}
                  </div>
                </div>
              </div>
              <div class="mt-6">
                <h4 class="text-lg font-semibold">Gallery</h4>
                <div class="grid grid-cols-1 gap-3 mt-3 sm:grid-cols-2">
                  <div class="h-40 rounded-md bg-slate-800/30" />
                  <div class="h-40 rounded-md bg-slate-800/30" />
                </div>
              </div>
            </div>
          )}
        </div>
      </article>
    ) : (
      <div class="py-12">
        <h2 class="text-2xl font-semibold">Project not found</h2>
        <p class="mt-2 text-slate-400">We couldn't find a project with that id.</p>
      </div>
    )
  }
</BaseLayout>

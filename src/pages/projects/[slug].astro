---
import { projects } from "../../data/content";
import { requireAuthentication, addPrivateHeaders, getUserScope } from "../../utils/auth";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

import type { Project } from "../../types";

export async function getStaticPaths() {
  return projects.map((p: Project) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project: Project | undefined = projects.find((p: Project) => p.slug === slug);

// Handle project not found
if (!project) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// Check authentication for private projects
if (project.private) {
  const authResponse = requireAuthentication(Astro, project.slug);
  if (authResponse) {
    return authResponse;
  }
}

// Determine user scope for access
const userScope = getUserScope(Astro);
const hasAccess =
  !project.private ||
  userScope
    ?.split(",")
    .map((s) => s.trim())
    .includes("*") ||
  userScope
    ?.split(",")
    .map((s) => s.trim())
    .includes(project.slug);
---

<BaseLayout title={`${project.title} | Portfolio`}>
  <article class="py-8">
    <div class="flex items-center gap-3 mb-6">
      <h1 class="text-3xl font-bold text-slate-100">{project.title}</h1>
      {
        project.private && (
          <span class="px-2 py-1 text-xs font-medium text-amber-300" aria-label="Private project">
            <Icon name="mdi:lock" class="w-4 h-4" />
          </span>
        )
      }
    </div>

    <p class="mt-3 text-lg text-slate-300">{project.description}</p>

    <div class="mt-6">
      <h3 class="text-sm uppercase text-slate-400 font-medium">Technologies</h3>
      <div class="flex flex-wrap gap-2 mt-2">
        {
          project.tags.map((tag) => (
            <span class="px-3 py-1 text-sm rounded-md bg-slate-800/40 text-slate-300 border border-slate-700/50">
              {tag}
            </span>
          ))
        }
      </div>
    </div>

    {
      project.date && (
        <div class="mt-4">
          <h3 class="text-sm uppercase text-slate-400 font-medium">Completed</h3>
          <p class="text-slate-300 mt-1">{project.date}</p>
        </div>
      )
    }

    <div class="mt-8">
      {
        hasAccess ? (
          <div class="space-y-8">
            {/* Key Highlights Section */}
            {project.highlights && project.highlights.length > 0 && (
              <div class="bg-slate-800/30 border border-slate-700/50 rounded-lg p-6">
                <h3 class="text-lg font-semibold text-slate-200 mb-4">Key Achievements</h3>
                <ul class="space-y-2">
                  {project.highlights.map((highlight) => (
                    <li class="flex items-start gap-2 text-slate-300">
                      <span class="text-green-400 mt-1">✓</span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {/* Main Content */}
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
              <div class="lg:col-span-2 space-y-6">
                <div class="prose prose-invert prose-slate max-w-none">
                  <h3>Project Overview</h3>
                  {project.private ? (
                    <div>
                      <p>
                        This is a private project showcasing advanced technical implementations and proprietary
                        solutions.
                      </p>
                      <p>
                        The project demonstrates expertise in {project.tags.slice(0, 3).join(", ")} and includes
                        detailed technical documentation, architecture decisions, and performance metrics.
                      </p>
                      {project.type === "professional" && (
                        <p>
                          This professional work was completed for enterprise clients and includes sensitive business
                          logic and proprietary implementations.
                        </p>
                      )}
                    </div>
                  ) : (
                    <div>
                      <p>
                        This public project demonstrates practical application of modern web technologies and
                        development best practices.
                      </p>
                      <p>
                        The implementation focuses on clean architecture, performance optimization, and user experience
                        design.
                      </p>
                    </div>
                  )}

                  {project.links && (
                    <div class="flex flex-wrap gap-4 mt-6">
                      {Object.entries(project.links).map(([key, url]) => {
                        let icon = null;
                        if (key === "github") icon = "📁";
                        else if (key === "demo") icon = "🔗";
                        else if (key === "paper") icon = "📄";
                        else if (key === "case_study") icon = "📊";
                        else if (key === "report") icon = "📋";
                        else if (key === "technical_details") icon = "⚙️";
                        return (
                          <a
                            href={url}
                            class="inline-flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium transition-colors bg-indigo-600 hover:bg-indigo-700 text-white"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {icon && <span>{icon}</span>}
                            <span class="capitalize">{key.replace(/_/g, " ")}</span>
                          </a>
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>

              {/* Sidebar */}
              <div class="space-y-6">
                <div class="bg-slate-800/30 border border-slate-700/50 rounded-lg p-4">
                  <h4 class="text-sm font-medium text-slate-300 mb-3">Project Type</h4>
                  <span class="inline-block px-3 py-1 text-sm rounded-md bg-slate-700/50 text-slate-300 capitalize">
                    {project.type}
                  </span>
                </div>

                {project.private && userScope && (
                  <div class="bg-green-900/20 border border-green-800/50 rounded-lg p-4">
                    <h4 class="text-sm font-medium text-green-300 mb-2">✅ Access Granted</h4>
                    <p class="text-xs text-green-400">You have authenticated access to this private project.</p>
                    <p class="text-xs text-slate-400 mt-2">Scope: {userScope}</p>
                  </div>
                )}
              </div>
            </div>

            {/* Gallery/Screenshots */}
            <div>
              <h3 class="text-lg font-semibold text-slate-200 mb-4">
                {project.private ? "Private Gallery" : "Project Gallery"}
              </h3>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <div
                  class={`h-48 rounded-lg flex items-center justify-center ${
                    project.private
                      ? "bg-gradient-to-br from-amber-900/20 to-orange-900/20 border border-amber-500/20"
                      : "bg-slate-800/30 border border-slate-700/50"
                  }`}
                >
                  <span class="text-sm text-slate-400">
                    {project.private ? "Private Screenshot 1" : "Screenshot 1"}
                  </span>
                </div>
                <div
                  class={`h-48 rounded-lg flex items-center justify-center ${
                    project.private
                      ? "bg-gradient-to-br from-amber-900/20 to-orange-900/20 border border-amber-500/20"
                      : "bg-slate-800/30 border border-slate-700/50"
                  }`}
                >
                  <span class="text-sm text-slate-400">
                    {project.private ? "Private Screenshot 2" : "Screenshot 2"}
                  </span>
                </div>
                <div
                  class={`h-48 rounded-lg flex items-center justify-center ${
                    project.private
                      ? "bg-gradient-to-br from-amber-900/20 to-orange-900/20 border border-amber-500/20"
                      : "bg-slate-800/30 border border-slate-700/50"
                  }`}
                >
                  <span class="text-sm text-slate-400">
                    {project.private ? "Private Architecture" : "Architecture"}
                  </span>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <div class="rounded-lg border border-red-800 bg-red-900/10 p-6">
            <h4 class="font-semibold text-red-300">Access Required</h4>
            <p class="mt-2 text-slate-300">
              This is a private project that requires authentication to view. Please use the access code from my resume.
            </p>
            <div class="mt-4">
              <a
                href="/access"
                class="inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-md transition-colors"
              >
                Request Access
              </a>
            </div>
          </div>
        )
      }
    </div>
  </article>

  {/* Not found case - this won't be reached due to server-side 404 above */}
</BaseLayout>

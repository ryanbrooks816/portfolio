---
export const prerender = true;

import { requireAuthentication, getUserScope } from "../../utils/auth";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";

import { Icon } from "astro-icon/components";

import { getProjects, renderProject } from "../../data/content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content } = await renderProject(project);

function formatDate(date?: Date) {
  if (!date) return "";
  return new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(date);
}

// Check authentication for private projects
if (project.data.private) {
  const authResponse = requireAuthentication(Astro, project.id);
  if (authResponse) {
    return authResponse;
  }
}

// Determine user scope for access
const userScope = getUserScope(Astro);
const hasAccess =
  !project.data.private ||
  userScope
    ?.split(",")
    .map((s) => s.trim())
    .includes("*") ||
  userScope
    ?.split(",")
    .map((s) => s.trim())
    .includes(project.id);

// Redirect to /access if user does not have access
if (!hasAccess) {
  return Astro.redirect("/access");
}

// Helper function to get link icon
function getLinkIcon(key: string) {
  const icons: Record<string, string> = {
    github: "mdi:github",
    demo: "mdi:open-in-new",
    paper: "mdi:file-document",
    case_study: "mdi:clipboard-text",
    report: "mdi:chart-box",
    technical_details: "mdi:cog",
  };
  return icons[key] || "mdi:link";
}
---

<BaseLayout title={`${project.data.title} | Portfolio`}>
  <Navigation />

  <!-- Hero Section -->
  <section class="relative pt-8 pb-16 overflow-hidden">
    <div>
      <!-- Back Navigation -->
      <div class="mb-8">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors group text-sm"
        >
          <Icon name="mdi:arrow-left" class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
          <span>Back to Projects</span>
        </a>
      </div>

      <!-- Project Badges & Date -->
      <div class="flex flex-wrap items-center gap-3 mb-8">
        <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
          {project.data.type.charAt(0).toUpperCase() + project.data.type.slice(1)} Project
        </span>
        {
          project.data.private && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
              <Icon name="mdi:lock" class="w-3.5 h-3.5" />
              Private
            </span>
          )
        }
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
          <Icon name="mdi:calendar" class="w-4 h-4" />
            <span>
            {formatDate(project.data.date)}
            {project.data.endDate
              ? ` – ${formatDate(project.data.endDate)}`
              : " – Present"}
            </span>
        </div>
      </div>
    </div>

      <!-- Project Content & Thumbnail -->
      <div class="flex flex-col lg:flex-row gap-8 items-center">
        <!-- Main Content -->
        <div class="w-full lg:w-1/2 space-y-8">
          <!-- Project Title & Subtitle -->
          <div>
            <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-4 leading-tight">
              {project.data.title}
            </h1>
            {
              project.data.subtitle && (
                <h2 class="text-lg md:text-xl lg:text-2xl text-slate-600 dark:text-slate-300 font-medium leading-relaxed">
                  {project.data.subtitle}
                </h2>
              )
            }
          </div>

          <!-- Project Description -->
          <div>
            <p class="text-base md:text-lg lg:text-xl text-slate-700 dark:text-slate-300 leading-relaxed">
              {project.data.description}
            </p>
          </div>

          <!-- Action Links -->
          {
            project.data.links && Object.keys(project.data.links).length > 0 && (
              <div class="flex flex-wrap gap-3">
                {Object.entries(project.data.links).map(
                  ([key, url], index) =>
                    url && (
                      <a
                        href={url}
                        class={`inline-flex items-center gap-2 px-4 py-2.5 lg:px-5 lg:py-3 rounded-lg font-medium transition-all hover:transform hover:scale-105 text-sm lg:text-base ${
                          index === 0 
                            ? "bg-slate-900 text-white hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-200 shadow-lg hover:shadow-xl" 
                            : "bg-slate-50 text-slate-900 hover:bg-slate-100 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700"
                        }`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <Icon name={getLinkIcon(key)} class="w-4 h-4 lg:w-5 lg:h-5" />
                        <span>{key.replace(/_/g, " ").replace(/\b\w/g, l => l.toUpperCase())}</span>
                      </a>
                    ),
                )}
              </div>
            )
          }
        </div>

        <!-- Project Thumbnail -->
        <div class="w-full lg:w-1/2 flex justify-center">
          {
            project.data.thumbnail && (
              <div class="w-full aspect-[16/9] rounded-xl overflow-hidden border border-slate-300 dark:border-slate-700 shadow-xl bg-slate-50 dark:bg-slate-800 flex">
                <img
                  src={project.data.thumbnail}
                  alt={`${project.data.title} thumbnail`}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Key Achievements -->
  {
    project.data.highlights && project.data.highlights.length > 0 && (
      <div class="my-16 py-8 border-t border-slate-300 dark:border-slate-700">
        <h3 class="ui-heading-lg mb-6">Key Achievements</h3>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {project.data.highlights.map((highlight) => (
            <li class="flex items-start gap-3 ui-list">
              <span class="text-slate-700 dark:text-slate-300 mt-0.5 flex-shrink-0 font-bold text-lg leading-none">✓</span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="space-y-12">
    {/* Project Overview Sections */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-8">
        {/* Rich Content from Markdown */}
        <section class="markdown max-w-none">
          <Content />
        </section>
      </div>

      {/* Sidebar */}
      <div class="space-y-8">
        <!-- Technologies -->
        <div class="border border-slate-300 dark:border-slate-700 rounded-lg p-6">
          <h3 class="ui-heading-sm mb-4">Technologies</h3>
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag) => <span class="tech-tag">{tag}</span>)}
          </div>
        </div>

        <!-- Timeline -->
        {
          project.data.timeline && project.data.timeline.length > 0 && (
            <div class="border border-slate-300 dark:border-slate-700 rounded-lg p-6">
              <h3 class="ui-heading-sm mb-4">Timeline</h3>
              <div class="space-y-4">
                {project.data.timeline.map((phase) => (
                  <div class="border-l-2 border-slate-400 dark:border-slate-600 pl-4 pb-4">
                    <div class="font-medium text-slate-900 dark:text-slate-200">{phase.phase}</div>
                    <div class="text-sm ui-p mb-1">{phase.duration}</div>
                    <div class="text-sm ui-p">{phase.description}</div>
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- Responsibilities -->
        {
          project.data.responsibilities && project.data.responsibilities.length > 0 && (
            <div class="border border-slate-300 dark:border-slate-700 rounded-lg p-6">
              <h3 class="ui-heading-sm mb-4">My Role</h3>
              <ul class="space-y-2">
                {project.data.responsibilities.map((responsibility) => (
                  <li class="flex items-start gap-2 text-sm ui-list">
                    <span class="text-slate-400 dark:text-slate-500 mt-1">•</span>
                    <span>{responsibility}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <!-- Access Status for Private Projects -->
        {
          project.data.private && userScope && (
            <div class="border border-slate-300 dark:border-slate-700 rounded-lg p-6">
              <h4 class="ui-heading-sm text-green-900 dark:text-green-300 mb-2">Access Granted</h4>
              <p class="text-sm ui-p mb-2">
                You have authenticated access to this private project.
              </p>
              <p class="text-xs ui-p">Scope: {userScope}</p>
            </div>
          )
        }
      </div>
    </div>

    <!-- Gallery Section -->
    {
      project.data.gallery?.images && project.data.gallery.images.length > 0 && (
        <section class="mt-16 pt-8 border-t border-slate-300 dark:border-slate-700">
          <h2 class="ui-heading-lg mb-6">
            {project.data.private ? "Private Gallery" : "Project Gallery"}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {project.data.gallery.images.map((image, index) => (
              <div class="group cursor-pointer">
                <div class="aspect-video border border-slate-300 dark:border-slate-700 rounded-lg overflow-hidden hover:border-slate-400 dark:hover:border-slate-600 transition-colors">
                  <div class="w-full h-full flex items-center justify-center bg-slate-50 dark:bg-slate-800">
                    <div class="text-center">
                      <Icon name="mdi:image" class="w-8 h-8 text-slate-400 dark:text-slate-500 mx-auto mb-2" />
                      <div class="text-xs ui-p">
                        {project.data.gallery?.captions?.[index] || `Screenshot ${index + 1}`}
                      </div>
                    </div>
                  </div>
                </div>
                {project.data.gallery?.captions?.[index] && (
                  <p class="mt-2 text-sm ui-p text-center">
                    {project.data.gallery.captions[index]}
                  </p>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Project Summary Section -->
    {
      (project.data.highlights || project.data.challenges || project.data.learnings) && (
        <section class="mt-16 pt-8 border-t border-slate-300 dark:border-slate-700">
          <h2 class="ui-heading-lg mb-8">Project Summary</h2>

          <div class="grid md:grid-cols-3 gap-8">
            <!-- Key Achievements -->
            {project.data.highlights && project.data.highlights.length > 0 && (
              <div>
                <h3 class="ui-heading-md mb-4">Key Achievements</h3>
                <ul class="space-y-3">
                  {project.data.highlights.map((highlight) => (
                    <li class="flex items-start gap-3 ui-list">
                      <span class="text-slate-600 dark:text-slate-400 mt-1">•</span>
                      <span class="text-sm leading-relaxed">{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Key Challenges -->
            {project.data.challenges && project.data.challenges.length > 0 && (
              <div>
                <h3 class="ui-heading-md mb-4">Key Challenges</h3>
                <ul class="space-y-3">
                  {project.data.challenges.map((challenge) => (
                    <li class="flex items-start gap-3 ui-list">
                      <span class="text-slate-600 dark:text-slate-400 mt-1">•</span>
                      <span class="text-sm leading-relaxed">{challenge}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Key Learnings -->
            {project.data.learnings && project.data.learnings.length > 0 && (
              <div>
                <h3 class="ui-heading-md mb-4">Key Learnings</h3>
                <ul class="space-y-3">
                  {project.data.learnings.map((learning) => (
                    <li class="flex items-start gap-3 ui-list">
                      <span class="text-slate-600 dark:text-slate-400 mt-1">•</span>
                      <span class="text-sm leading-relaxed">{learning}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )
    }
  </div>

  <!-- Navigation -->
  <nav class="mt-16 pt-8 border-t border-slate-300 dark:border-slate-700">
    <div class="flex justify-between items-center">
      <a
        href="/projects"
        class="ui-button-secondary"
      >
        <Icon name="mdi:arrow-left" class="w-4 h-4" />
        Back to Projects
      </a>
      <div class="flex items-center gap-2 text-sm ui-p">
        <Icon name="mdi:calendar" class="w-4 h-4" />
        <span>{formatDate(project.data.date)}{project.data.endDate && ` - ${formatDate(project.data.endDate)}`}</span>
      </div>
    </div>
  </nav>
</BaseLayout>


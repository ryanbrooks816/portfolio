---
import { text, omni, coursework, interests, skills } from "../data/text";

import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLayout from "../layouts/SectionLayout.astro";
import HomeNavigation from "../components/HomeNavigation.astro";
import TextLink from "../components/TextLink.astro";
import FeaturedProjectCard from "../components/FeaturedProjectCard.astro";
import ExperienceCard from "../components/ExperienceCard.astro";

import { Icon } from "astro-icon/components";

import { getProjects } from "../data/projects";

const projects = await getProjects();

// Sort projects by date (most recent first) and take top 4
const recentProjects = projects
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);
---

<BaseLayout title="Home | Portfolio">
  <HomeNavigation />

  <div class="lg:flex lg:justify-between lg:gap-8">
    <!-- Sticky Left Sidebar -->
    <div class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-1/2 lg:flex-col lg:justify-between lg:py-28">
      <div>
        <h1
          class="text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-200 sm:text-5xl"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <a href="/">{text.name}</a>
        </h1>
        <h2
          class="mt-4 text-base font-bold tracking-tight text-slate-700 dark:text-slate-200"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          {
            text.title.map((t) => (
              <span>
                {t}
                <br />
              </span>
            ))
          }
        </h2>
        <p
          class="mt-6 max-w-xs text-lg leading-normal text-slate-600 dark:text-slate-400"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          {text.tagline}
        </p>

        <!-- Key Interests -->
        <div class="mt-8" data-aos="fade-up" data-aos-delay="400">
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-widest text-slate-600 dark:text-slate-300">
            Interests
          </h3>
          <div class="flex flex-wrap gap-2">
            {interests.map((interest) => <span class="ui-tag purple text-xs">{interest}</span>)}
          </div>
        </div>
      </div>

      <!-- Social Icons - Sticky Bottom -->
      <ul class="ml-1 mt-8 flex items-center" aria-label="Social media" data-aos="fade-up" data-aos-delay="500">
        <li class="mr-5 text-xs shrink-0">
          <a
            class="block text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200"
            href={text.contact.github}
            target="_blank"
            rel="noreferrer noopener"
            aria-label="GitHub (opens in a new tab)"
            title="GitHub"
          >
            <span class="sr-only">GitHub</span>
            <Icon name="mdi:github" class="h-6 w-6" />
          </a>
        </li>
        <li class="mr-5 text-xs shrink-0">
          <a
            class="block text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200"
            href={text.contact.linkedin}
            target="_blank"
            rel="noreferrer noopener"
            aria-label="LinkedIn (opens in a new tab)"
            title="LinkedIn"
          >
            <span class="sr-only">LinkedIn</span>
            <Icon name="mdi:linkedin" class="h-6 w-6" />
          </a>
        </li>
        <li class="mr-5 text-xs shrink-0">
          <a
            class="block text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200"
            href={`mailto:${text.contact.email}`}
            aria-label="Email (opens your email client)"
            title="Email"
          >
            <span class="sr-only">Email</span>
            <Icon name="mdi:email" class="h-6 w-6" />
          </a>
        </li>
        <li class="mr-5 text-xs shrink-0">
          <a
            class="block text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200"
            href={text.contact.resume}
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Resume (opens in a new tab)"
            title="Resume"
          >
            <span class="sr-only">Resume</span>
            <Icon name="mdi:file-document-outline" class="h-6 w-6" />
          </a>
        </li>
      </ul>
    </div>

    <!-- Scrollable Right Content -->
    <div class="pt-28 md:pr-24 lg:w-1/2 lg:py-28 lg:pr-20">
      <!-- About Section -->
      <SectionLayout id="section-about" heading="About" delay={2}>
        <div class="space-y-4">
          <p class="mb-4 text-slate-600 dark:text-slate-400">
            {text.about.intro}
          </p>
          <p class="mb-4 text-slate-600 dark:text-slate-400">
            {text.about.focus}
          </p>
          <p class="text-slate-600 dark:text-slate-400">
            {text.about.personal}
          </p>
        </div>
      </SectionLayout>

      <!-- Experience & Education Section -->
      <SectionLayout id="section-experience" heading="Experience & Education" delay={3}>
        <ol class="group/list">
          <li class="mb-12">
            <ExperienceCard
              title="OMNI Digital Services"
              description="Full-Stack Developer"
              date="2023-07"
              endDate="Present"
            >
              <ul class="space-y-3 text-sm">
                {
                  omni.map((item) => (
                    <li class="flex items-start">
                      <span class="mr-3 text-slate-600 dark:text-slate-400">•</span>
                      <span class="text-slate-600 dark:text-slate-400">{item}</span>
                    </li>
                  ))
                }
              </ul>
            </ExperienceCard>
          </li>
          <li class="mb-12">
            <ExperienceCard
              title={text.experience.university.name}
              description={text.experience.university.description}
              date={text.experience.university.startDate}
              endDate={text.experience.university.endDate}
            >
              <div class="flex flex-wrap gap-2">
                {coursework.map((course) => <span class="text-slate-700 dark:text-slate-500">{course}</span>)}
              </div>
            </ExperienceCard>
          </li>

          <!-- Resume Link -->
          <div class="mt-12">
            <TextLink href={text.contact.resume} label="View Full Résumé" />
          </div>
        </ol>
      </SectionLayout>
    </div>
  </div>

  <!-- Projects Section -->
  <SectionLayout id="section-projects" heading="Featured Projects" delay={4}>
    <ul class="group/list">
      {
        recentProjects.map((project) => (
          <>
            <li class="mb-12">
              <FeaturedProjectCard project={project} />
            </li>
            <hr class="ui-divider my-12" />
          </>
        ))
      }
    </ul>
    <div class="mt-12">
      <TextLink href="/projects" label="View All Projects" />
    </div>
  </SectionLayout>

  <!-- Skills & Technologies Section -->
  <SectionLayout id="section-skills" heading="Skills & Technologies" delay={5}>
    <div class="mb-8">
      <p class="leading-relaxed text-slate-600 dark:text-slate-400">
        {text.skillsIntro}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="space-y-3">
        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-200">Languages</h3>
        <div class="flex flex-wrap gap-2">
          {skills.languages.map((s) => <span class="ui-tag purple">{s}</span>)}
        </div>
      </div>
      <div class="space-y-3">
        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-200">Frontend</h3>
        <div class="flex flex-wrap gap-2">
          {skills.frontend.map((s) => <span class="ui-tag purple">{s}</span>)}
        </div>
      </div>
      <div class="space-y-3">
        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-200">Backend</h3>
        <div class="flex flex-wrap gap-2">
          {skills.backend.map((s) => <span class="ui-tag purple">{s}</span>)}
        </div>
      </div>
      <div class="space-y-3">
        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-200">DevOps</h3>
        <div class="flex flex-wrap gap-2">
          {skills.devops.map((s) => <span class="ui-tag purple">{s}</span>)}
        </div>
      </div>
      <div class="space-y-3">
        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-200">Machine Learning</h3>
        <div class="flex flex-wrap gap-2">
          {skills.ml.map((s) => <span class="ui-tag purple">{s}</span>)}
        </div>
      </div>
      <div class="space-y-3">
        <h3 class="text-base font-semibold text-slate-900 dark:text-slate-200">Tools & Analytics</h3>
        <div class="flex flex-wrap gap-2">
          {skills.product_growth.map((s) => <span class="ui-tag purple">{s}</span>)}
        </div>
      </div>
    </div>
  </SectionLayout>

  <!-- Research Interests Section -->
  <SectionLayout id="section-research" heading="Research & Interests" delay={6}>
    <div class="mb-8">
      <p class="text-base leading-relaxed text-slate-600 dark:text-slate-400">
        {text.researchIntro}
      </p>
    </div>

    <div class="space-y-6">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-200">Current Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 sm:grid-cols-2 gap-4">
        {
          interests.map((interest) => (
            <div class="group bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1">
              <h4 class="text-sm font-medium text-slate-900 dark:text-slate-100 group-hover:text-slate-800 dark:group-hover:text-white transition-colors">
                {interest}
              </h4>
            </div>
          ))
        }
      </div>
    </div>
  </SectionLayout>
</BaseLayout>

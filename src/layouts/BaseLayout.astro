---
import "../styles/style.css";

import AnimatedGradient from "../components/AnimatedGradient.astro";
import Navbar from "../components/Navbar.astro";

const { title = "Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta
      name="description"
      content="Computer Science + Applied Mathematics student at URI. Building full-stack applications and system design tools."
    />
  </head>
  <body
    class="relative min-h-screen antialiased bg-gradient-to-b from-slate-50 via-white to-slate-100 text-slate-900 dark:bg-gradient-to-b dark:from-slate-900 dark:via-slate-950 dark:to-black dark:text-slate-100"
  >
    <AnimatedGradient />
    <div class="relative z-10 max-w-5xl px-6 mx-auto sm:px-8">
      <Navbar />

      <main class="relative">
        <slot />
      </main>

      <footer class="py-16 text-sm text-center text-slate-400 dark:text-slate-500">
        <p>
          © {new Date().getFullYear()} — Ryan Brooks
        </p>
      </footer>
    </div>
  </body>
</html>

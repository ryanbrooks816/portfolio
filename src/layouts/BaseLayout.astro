---
import "../styles/style.css";
import "aos/dist/aos.css";

import AnimatedGradient from "../components/AnimatedGradient.astro";

import { Icon } from "astro-icon/components";

import { text } from "../data/text";

const { title = "Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={`${text.title}. ${text.tagline}`} />
  </head>
  <body
    class="relative min-h-screen antialiased bg-gradient-to-br from-slate-50/90 via-white/95 to-slate-100/90 text-slate-900 dark:bg-gradient-to-b dark:from-[#0d0d0d] dark:via-[#080808] dark:to-[#030303] dark:text-neutral-100"
  >
    <AnimatedGradient />

    <div class="mx-auto min-h-screen max-w-screen-xl px-6 pt-32 pb-8">
      <main class="relative">
        <slot />
      </main>

      <footer class="pt-16 text-sm text-slate-400 dark:text-neutral-500">
        <hr class="ui-divider" />

        <div class="pt-8 pb-12">
          <h4 class="mb-2 text-lg font-bold tracking-tight text-slate-900 dark:text-neutral-100">Let's Get In Touch</h4>
          <div class="grid grid-cols-1 items-start gap-12 md:grid-cols-[minmax(0,1fr)_auto]">
            <div class="max-w-md">
              <p class="leading-relaxed text-slate-600 dark:text-neutral-400">
                {text.contactSection.description}
              </p>
            </div>
            <a
              href={`mailto:${text.contact.email}`}
              class="group inline-flex items-center justify-self-start font-semibold text-slate-900 underline decoration-slate-300 underline-offset-4 transition-colors hover:decoration-current dark:text-white dark:decoration-slate-600 md:justify-self-end"
            >
              <span>{text.contact.email}</span>
              <Icon
                name="mdi:arrow-top-right"
                class="ml-1 h-4 w-4 transition-transform group-hover:-translate-y-1 group-hover:translate-x-1"
              />
            </a>
          </div>
        </div>

        <p class="m-0 text-center">© {new Date().getFullYear()} — {text.name}</p>
      </footer>
    </div>

    <script>
      import AOS from "aos";
      AOS.init({
        duration: 800,
        easing: "ease-out-cubic",
        once: true,
        offset: 50,
        delay: 100,
      });
    </script>
  </body>
</html>

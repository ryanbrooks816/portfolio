---
interface Props {
  id: string;
  heading: string;
  delay?: number;
}

const { id, heading, delay = 0 } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
  aria-labelledby={headingId}
  data-aos="fade-up"
  data-aos-delay={delay * 100}
>
  <header class="section-heading ui-divider" data-aos="fade-up" data-aos-delay={delay * 100 + 50}>
    <h2 id={headingId} class="m-0 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">{heading}</h2>
  </header>

  <div data-aos="fade-up" data-aos-delay={delay * 100 + 150}>
    <slot />
  </div>
</section>

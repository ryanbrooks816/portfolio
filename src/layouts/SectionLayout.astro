---
const props = Astro.props;
---

<section id={props.id} class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24" aria-label={props.heading}>
  <div
    class="sticky top-0 z-30 -mx-6 mb-8 w-screen bg-gray-800/80 px-6 py-8 backdrop-blur-lg border-b border-gray-700 shadow-xl sm:-mx-6 sm:px-6 md:sr-only md:relative md:top-auto md:mx-auto md:w-full md:px-0 md:py-0 md:opacity-0 transition-all duration-300"
  >
    <h2 class="text-base font-bold uppercase tracking-widest text-slate-100 drop-shadow-sm lg:sr-only">
      {props.heading}
    </h2>
  </div>
  <slot />
</section>

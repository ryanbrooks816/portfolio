---
export type GalleryImage = {
  src: string;
  alt: string;
  caption?: string;
};

export interface Props {
  /** Images can be objects with alt text, or simple paths with captions supplied separately. */
  images: Array<GalleryImage | string>;
  captions?: string[];
  /** Used for simple string image paths that do not have their own alt text. */
  alt?: string;
  label?: string;
}

const { images, captions, alt = "Gallery image", label = "Image gallery" } = Astro.props;

const normalizedImages = images.map((image, index) =>
  typeof image === "string"
    ? {
        src: image,
        alt: `${alt} ${index + 1}`,
        caption: captions?.[index],
      }
    : image,
);

const hasMultipleImages = normalizedImages.length > 1;
---

{
  normalizedImages.length > 0 && (
    <div class="gallery" data-gallery role="region" aria-label={label} tabindex="0">
      <div class="gallery__viewport">
        <img
          class="gallery__image"
          data-gallery-image
          src={normalizedImages[0].src}
          alt={normalizedImages[0].alt}
          loading="eager"
          decoding="async"
          draggable="false"
        />

        {hasMultipleImages && (
          <>
            <button
              class="gallery__arrow gallery__arrow--previous"
              type="button"
              data-gallery-previous
              aria-label="Previous image"
            >
              <span aria-hidden="true">←</span>
            </button>
            <button class="gallery__arrow gallery__arrow--next" type="button" data-gallery-next aria-label="Next image">
              <span aria-hidden="true">→</span>
            </button>
          </>
        )}
      </div>

      <p class="gallery__caption" data-gallery-caption hidden={!normalizedImages[0].caption}>
        {normalizedImages[0].caption}
      </p>

      {hasMultipleImages && (
        <div class="gallery__thumbnails" data-gallery-thumbnails role="list" aria-label="Choose an image">
          {normalizedImages.map((image, index) => (
            <div role="listitem">
              <button
                class:list={{ gallery__thumbnail: true, "is-active": index === 0 }}
                type="button"
                data-gallery-thumbnail
                data-index={index}
                data-src={image.src}
                data-alt={image.alt}
                data-caption={image.caption}
                aria-label={`Show image ${index + 1}`}
                aria-current={index === 0 ? "true" : undefined}
              >
                <img src={image.src} alt="" loading="lazy" decoding="async" draggable="false" />
              </button>
            </div>
          ))}
        </div>
      )}

      <p class="sr-only" data-gallery-status aria-live="polite">
        Showing image 1 of {normalizedImages.length}: {normalizedImages[0].alt}
      </p>
    </div>
  )
}

<script is:inline>
  (() => {
    const script = document.currentScript;
    const gallery = script?.previousElementSibling;

    if (!(gallery instanceof HTMLElement) || !gallery.matches("[data-gallery]")) return;

    const image = gallery.querySelector("[data-gallery-image]");
    const caption = gallery.querySelector("[data-gallery-caption]");
    const status = gallery.querySelector("[data-gallery-status]");
    const thumbnails = Array.from(gallery.querySelectorAll("[data-gallery-thumbnail]"));
    const previous = gallery.querySelector("[data-gallery-previous]");
    const next = gallery.querySelector("[data-gallery-next]");

    if (!(image instanceof HTMLImageElement) || thumbnails.length < 2) return;

    let currentIndex = 0;

    const showImage = (nextIndex) => {
      currentIndex = (nextIndex + thumbnails.length) % thumbnails.length;
      const thumbnail = thumbnails[currentIndex];

      if (!(thumbnail instanceof HTMLElement)) return;

      const { src, alt, caption: captionText } = thumbnail.dataset;
      if (!src) return;

      image.src = src;
      image.alt = alt || "";

      thumbnails.forEach((item, index) => {
        const isActive = index === currentIndex;
        item.classList.toggle("is-active", isActive);
        if (isActive) item.setAttribute("aria-current", "true");
        else item.removeAttribute("aria-current");
      });

      if (caption instanceof HTMLElement) {
        caption.textContent = captionText || "";
        caption.hidden = !captionText;
      }

      if (status instanceof HTMLElement) {
        status.textContent = `Showing image ${currentIndex + 1} of ${thumbnails.length}: ${alt || "Gallery image"}`;
      }
    };

    previous?.addEventListener("click", () => showImage(currentIndex - 1));
    next?.addEventListener("click", () => showImage(currentIndex + 1));

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener("click", () => showImage(index));
    });

    gallery.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        showImage(currentIndex - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        showImage(currentIndex + 1);
      } else if (event.key === "Home") {
        event.preventDefault();
        showImage(0);
      } else if (event.key === "End") {
        event.preventDefault();
        showImage(thumbnails.length - 1);
      }
    });
  })();
</script>

<style>
  .gallery {
    --gallery-border: rgb(203 213 225);
    --gallery-surface: rgb(248 250 252);
    --gallery-control: rgb(15 23 42 / 0.84);
    --gallery-focus: rgb(79 70 229);
    margin: 2rem 0;
    outline: none;
  }

  .gallery:focus-visible {
    border-radius: 0.75rem;
    box-shadow: 0 0 0 3px var(--gallery-focus);
  }

  .gallery__viewport {
    position: relative;
    display: grid;
    min-height: 15rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--gallery-border);
    border-radius: 0.75rem;
    background: var(--gallery-surface);
  }

  .gallery .gallery__image {
    display: block;
    margin: 0;
    width: 100%;
    max-height: min(70vh, 42rem);
    object-fit: contain;
    border-radius: 0;
    box-shadow: none;
  }

  .gallery__arrow {
    position: absolute;
    top: 50%;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: var(--gallery-control);
    color: white;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    opacity: 0.9;
    transform: translateY(-50%);
    transition:
      background-color 150ms ease,
      opacity 150ms ease,
      transform 150ms ease;
  }

  .gallery__arrow:hover {
    background: rgb(15 23 42);
    opacity: 1;
  }

  .gallery__arrow:focus-visible,
  .gallery__thumbnail:focus-visible {
    outline: 3px solid var(--gallery-focus);
    outline-offset: 2px;
  }

  .gallery__arrow:active {
    transform: translateY(-50%) scale(0.95);
  }

  .gallery__arrow--previous {
    left: 0.75rem;
  }

  .gallery__arrow--next {
    right: 0.75rem;
  }

  .gallery .gallery__caption {
    margin: 0.75rem 0 0;
    color: rgb(71 85 105);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
  }

  .gallery__thumbnails {
    display: flex;
    gap: 0.625rem;
    margin-top: 0.875rem;
    overflow-x: auto;
    padding: 0.25rem;
    scrollbar-width: thin;
  }

  .gallery__thumbnails > [role="listitem"] {
    flex: 0 0 5.25rem;
  }

  .gallery__thumbnail {
    width: 100%;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 0.5rem;
    background: var(--gallery-surface);
    cursor: pointer;
    opacity: 0.65;
    transition:
      border-color 150ms ease,
      opacity 150ms ease;
  }

  .gallery__thumbnail:hover,
  .gallery__thumbnail.is-active {
    border-color: var(--gallery-focus);
    opacity: 1;
  }

  .gallery .gallery__thumbnail img {
    display: block;
    margin: 0;
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
    border-radius: 0;
    box-shadow: none;
  }

  @media (min-width: 640px) {
    .gallery__thumbnails > [role="listitem"] {
      flex-basis: 6.5rem;
    }
  }

  :global(html.dark) .gallery {
    --gallery-border: rgb(51 65 85);
    --gallery-surface: rgb(30 41 59);
    --gallery-control: rgb(226 232 240 / 0.88);
    --gallery-focus: rgb(129 140 248);
  }

  :global(html.dark) .gallery__arrow {
    color: rgb(15 23 42);
  }

  :global(html.dark) .gallery__arrow:hover {
    background: rgb(248 250 252);
  }

  :global(html.dark) .gallery__caption {
    color: rgb(148 163 184);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__arrow,
    .gallery__thumbnail {
      transition: none;
    }
  }
</style>

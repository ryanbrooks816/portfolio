---
import DarkToggle from "./DarkToggle.astro";

import { text } from "../data/text";
---

<nav class="fixed left-6 right-6 top-6 z-50 flex items-center justify-between" aria-label="Main navigation">
  <!-- Logo/Home Link -->
  <a href="/" class="nav-section flex shrink-0 items-center gap-3 px-3 py-1">
    <img class="h-10 w-10 rounded-full" src="/photo.webp" alt={text.name} />
    <span class="hidden font-semibold text-slate-900 dark:text-white sm:inline">{text.name}</span>
  </a>

  <div class="nav-section flex items-center gap-2 px-2 py-1">
    <!-- Navigation Links -->
    {
      Astro.slots.has("nav-links") && (
        <div class="hidden items-center gap-1 md:flex">
          <slot name="nav-links" />
        </div>
      )
    }

    <DarkToggle />
  </div>
</nav>

<!-- Optional content for navigation controls -->
<slot />

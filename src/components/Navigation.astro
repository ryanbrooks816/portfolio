---
import { Icon } from "astro-icon/components";

import DarkToggle from "./DarkToggle.astro";
---

<nav
  class="fixed top-6 left-6 right-6 z-50 flex items-center gap-2 md:gap-0 justify-end md:justify-between"
  aria-label="Main navigation"
>
  <!-- Logo/Home Link -->
  <a href="/" class="hidden sm:flex items-center gap-3 px-4 py-1 nav-section">
    <img class="w-8 h-8 rounded-full" src="/photo.jpeg" alt="Ryan Brooks" />
    <span class="font-semibold text-slate-900 dark:text-white">Ryan Brooks</span>
  </a>

  <!-- Navigation Links -->
  <div class="hidden md:flex items-center gap-1 px-2 py-1 nav-section">
    <slot name="nav-links" />
  </div>

  <div class="flex items-center gap-2 px-2 py-1 nav-section">
    <DarkToggle />
  </div>
</nav>

<!-- Optional content for navigation controls -->
<slot />

<!-- Spacer to prevent content from going behind navbar -->
<div class="h-20"></div>

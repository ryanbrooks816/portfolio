---
import { Icon } from "astro-icon/components";

import { formatProjectDate, getProjectUrl, getPrimaryProjectLink } from "../data/projects";
import type { Project } from "../data/projects";

const props = Astro.props as { project: Project };
const { project } = props;

const primaryLink = getPrimaryProjectLink(project);
---

<tr
  class="border-b border-slate-300 dark:border-slate-600 last:border-none hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors"
>
  <td class="py-4 px-4 align-top text-sm">
    <div class="translate-y-px text-slate-600 dark:text-slate-400">{formatProjectDate(project.data.date)}</div>
  </td>
  <td class="py-4 px-4 align-top font-semibold leading-snug text-slate-900 dark:text-slate-200">
    <div>
      <div class="flex items-center gap-2">
        <div class="block sm:hidden">
          <a
            class="inline-flex items-baseline font-medium leading-tight text-slate-900 hover:text-blue-600 focus-visible:text-blue-600 dark:text-slate-200 dark:hover:text-blue-400 dark:focus-visible:text-blue-400 group/link text-base transition-colors"
            href={getProjectUrl(project)}
            aria-label={`${project.data.title} project details`}
          >
            <span>{project.data.title}</span>
            <Icon
              name="mdi:arrow-top-right"
              class="ml-0.5 h-4 w-4 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
            />
          </a>
        </div>
        <div class="hidden sm:block">{project.data.title}</div>
        {
          project.data.private && (
            <span class="px-2 py-1 text-xs font-medium text-amber-300" aria-label="Private project">
              <Icon name="mdi:lock" class="w-4 h-4" />
            </span>
          )
        }
      </div>
    </div>
    <div class="mt-2 text-sm leading-normal text-slate-600 dark:text-slate-400">{project.data.description}</div>
    <ul class="mt-2 flex flex-wrap lg:hidden" aria-label="Technologies used">
      {
        project.data.tags.map((tag) => (
          <li class="mr-1.5 mt-2">
            <div class="flex items-center ui-tag blue">{tag}</div>
          </li>
        ))
      }
    </ul>
  </td>
  <td class="hidden py-4 px-4 align-top lg:table-cell">
    <ul class="flex -translate-y-1.5 flex-wrap">
      {
        project.data.tags.map((tag) => (
          <li class="my-1 mr-1.5">
            <div class="flex items-center ui-tag blue">{tag}</div>
          </li>
        ))
      }
    </ul>
  </td>
  <td class="hidden py-4 px-4 align-top text-sm sm:table-cell">
    <div class="translate-y-px whitespace-nowrap text-slate-600 dark:text-slate-400 capitalize">
      {project.data.type}
    </div>
  </td>
  <td class="py-4 px-4 align-top">
    <ul class="translate-y-px">
      <li class="mb-3 flex items-center">
        <a
          class="inline-flex items-baseline font-medium leading-tight text-slate-600 hover:text-blue-600 focus-visible:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 dark:focus-visible:text-blue-400 text-sm group/link transition-colors"
          href={getProjectUrl(project)}
          aria-label={`View ${project.data.title} details`}
        >
          <span>View</span>
          <Icon
            name="mdi:arrow-top-right"
            class="ml-0.5 h-3 w-3 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
          />
        </a>
      </li>
      {
        primaryLink?.key === "github" && (
          <li class="mb-1 flex items-center">
            <a
              class="inline-flex items-baseline font-medium leading-tight text-slate-600 hover:text-blue-600 focus-visible:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 dark:focus-visible:text-blue-400 text-sm group/link transition-colors"
              href={primaryLink.url}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={`${project.data.title} GitHub (opens in a new tab)`}
            >
              <span>GitHub</span>
              <Icon
                name="mdi:arrow-top-right"
                class="ml-0.5 h-3 w-3 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
              />
            </a>
          </li>
        )
      }
    </ul>
  </td>
</tr>

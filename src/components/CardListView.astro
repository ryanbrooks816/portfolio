---
import { Icon } from "astro-icon/components";

import { formatProjectDate, getProjectUrl, getPrimaryProjectLink } from "../data/projects";
import type { Project } from "../data/projects";

const props = Astro.props as { project: Project };
const { project } = props;

const primaryLink = getPrimaryProjectLink(project);
---

<tr
  class="group border-b border-slate-300 transition-colors last:border-none hover:bg-slate-100 dark:border-neutral-700 dark:hover:bg-neutral-900/70"
>
  <td class="py-4 px-4 align-top text-sm">
    <div class="translate-y-px text-slate-600 dark:text-neutral-400">{formatProjectDate(project.data.date)}</div>
  </td>
  <td class="py-4 px-4 align-top font-semibold leading-snug text-slate-900 dark:text-neutral-200">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="m-0">
          <a class="project-title" href={getProjectUrl(project)} aria-label={`${project.data.title} project details`}>
            <span>{project.data.title}</span>
            <Icon name="mdi:arrow-top-right" class="project-title-arrow" />
          </a>
        </h3>
        {
          project.data.private && (
            <span class="px-2 py-1 text-xs font-medium text-amber-300" aria-label="Private project">
              <Icon name="mdi:lock" class="w-4 h-4" />
            </span>
          )
        }
      </div>
    </div>
    <div class="project-description mt-2">{project.data.description}</div>
    <ul class="mt-2 flex flex-wrap lg:hidden" aria-label="Technologies used">
      {
        project.data.tags.map((tag) => (
          <li class="mr-1.5 mt-2">
            <div class="flex items-center ui-tag blue">{tag}</div>
          </li>
        ))
      }
    </ul>
  </td>
  <td class="hidden py-4 px-4 align-top lg:table-cell">
    <ul class="flex -translate-y-1.5 flex-wrap">
      {
        project.data.tags.map((tag) => (
          <li class="my-1 mr-1.5">
            <div class="flex items-center ui-tag blue">{tag}</div>
          </li>
        ))
      }
    </ul>
  </td>
  <td class="hidden py-4 px-4 align-top text-sm sm:table-cell">
    <div class="translate-y-px whitespace-nowrap text-slate-600 dark:text-neutral-400 capitalize">
      {project.data.type}
    </div>
  </td>
  <td class="py-4 px-4 align-top">
    <ul class="translate-y-px">
      <li class="mb-3 flex items-center">
        <a
          class="group/link inline-flex items-baseline text-sm font-medium leading-tight text-slate-900 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-slate-900 hover:decoration-current focus-visible:text-slate-900 dark:text-neutral-100 dark:decoration-neutral-600 dark:hover:text-white dark:focus-visible:text-white"
          href={getProjectUrl(project)}
          aria-label={`View ${project.data.title} details`}
        >
          <span>View</span>
          <Icon
            name="mdi:arrow-top-right"
            class="ml-0.5 h-3 w-3 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
          />
        </a>
      </li>
      {
        primaryLink?.key === "github" && (
          <li class="mb-1 flex items-center">
            <a
              class="group/link inline-flex items-baseline text-sm font-medium leading-tight text-slate-900 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-slate-900 hover:decoration-current focus-visible:text-slate-900 dark:text-neutral-100 dark:decoration-neutral-600 dark:hover:text-white dark:focus-visible:text-white"
              href={primaryLink.url}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={`${project.data.title} GitHub (opens in a new tab)`}
            >
              <span>GitHub</span>
              <Icon
                name="mdi:arrow-top-right"
                class="ml-0.5 h-3 w-3 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
              />
            </a>
          </li>
        )
      }
    </ul>
  </td>
</tr>

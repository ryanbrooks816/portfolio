---
export interface Props {
  projectSlug: string;
  projectTitle: string;
}

const { projectSlug, projectTitle } = Astro.props;
---

<div id="password-gate" class="rounded-lg border border-amber-800 bg-amber-900/10 p-6">
  <h4 class="font-semibold text-amber-300">Private Project</h4>
  <p class="mt-2 text-neutral-300">
    This project requires a password to view. Enter your password below or directly through my resume.
  </p>

  <div class="mt-4 space-y-3">
    <div>
      <label for="project-password" class="block text-sm font-medium text-neutral-300">Password</label>
      <div class="mt-1 flex gap-2">
        <input
          type="password"
          id="project-password"
          class="flex-1 rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-neutral-200 placeholder-neutral-500 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-amber-500"
          placeholder="Enter password"
        />
        <button
          id="unlock-project"
          class="rounded-md bg-amber-500 px-4 py-2 font-medium text-neutral-950 hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 focus:ring-offset-neutral-950"
        >
          Unlock
        </button>
      </div>
    </div>

    <div id="password-error" class="hidden">
      <p class="text-sm text-red-400">Incorrect password. Please try again.</p>
    </div>

    <div id="password-success" class="hidden">
      <p class="text-sm text-green-400">Access granted! Loading project details...</p>
    </div>
  </div>
</div>

<div id="protected-content" class="hidden">
  <div class="mt-6">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="prose prose-invert text-neutral-200">
        <h4>Private Project Details</h4>
        <p>You now have access to this private project. Here are the exclusive details and resources.</p>
        <p class="mt-4">
          <a class="text-neutral-300 hover:text-neutral-100" href="#" onclick="alert('Demo link would go here')"
            >🔗 View Private Demo</a
          > ·
          <a class="text-neutral-300 hover:text-neutral-100" href="#" onclick="alert('Private repo link would go here')"
            >📁 Private Repository</a
          >
        </p>
      </div>

      <div class="glass rounded-md p-4">
        <h5 class="text-sm text-neutral-300">Exclusive Features</h5>
        <ul class="mt-2 space-y-1 text-sm text-neutral-400">
          <li>• Advanced analytics dashboard</li>
          <li>• Real-time data visualization</li>
          <li>• Custom API integrations</li>
          <li>• Internal documentation access</li>
        </ul>
      </div>
    </div>

    <div class="mt-6">
      <h4 class="text-lg font-semibold">Private Gallery</h4>
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div
          class="flex h-40 items-center justify-center rounded-md bg-gradient-to-br from-amber-900/20 to-orange-900/20"
        >
          <span class="text-sm text-neutral-400">Private Screenshot 1</span>
        </div>
        <div
          class="flex h-40 items-center justify-center rounded-md bg-gradient-to-br from-amber-900/20 to-orange-900/20"
        >
          <span class="text-sm text-neutral-400">Private Screenshot 2</span>
        </div>
      </div>
    </div>

    <div class="mt-4 rounded-md border border-green-800 bg-green-900/10 p-3">
      <p class="text-sm text-green-300">
        ✅ You're viewing private content for: <strong>{projectTitle}</strong>
      </p>
      <button id="lock-project" class="mt-2 text-xs text-green-400 underline hover:text-green-300">
        Lock project again
      </button>
    </div>
  </div>
</div>

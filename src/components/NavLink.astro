---
const { href, label, section, classes } = Astro.props;
---

<a
  href={href}
  class=`nav-link px-4 py-2 rounded-full text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/60 dark:hover:bg-slate-700/60 transition-all duration-200 ${classes || ""}`
  data-section={section}
>
  {label}
</a>

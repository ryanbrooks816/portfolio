---
const { href, label, section, classes } = Astro.props;
---

<a
  href={href}
  class=`nav-link rounded-full px-4 py-2 text-sm font-medium text-slate-900 decoration-slate-300 transition-all duration-200 hover:bg-slate-100/60 hover:decoration-current dark:text-neutral-100 dark:decoration-neutral-600 dark:hover:bg-neutral-800/70 ${classes || ""}`
  data-section={section}
>
  {label}
</a>

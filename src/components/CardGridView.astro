---
import { Icon } from "astro-icon/components";

import type { CollectionEntry } from "astro:content";
type Project = CollectionEntry<"projects">;

const props = Astro.props as { project: Project };
const { project } = props;

function formatDate(date?: Date) {
  if (!date) return "";
  return new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(date);
}
---

<article
  class="group relative gap-4 pb-1 transition-all sm:gap-8 md:gap-4 lg:hover:!opacity-100"
  data-title={project.data.title}
  data-p={project.data.description}
  data-type={project.data.type}
  data-tags={project.data.tags.join(",")}
  data-access={project.data.private ? "private" : "public"}
  data-featured={project.data.featured ? "true" : "false"}
>
  <div
    class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-gray-200/60 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(100,116,139,0.08)] lg:group-hover:drop-shadow-md dark:lg:group-hover:bg-slate-800/60 dark:lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.10)]"
  >
  </div>

  <a href={`/projects/${project.id}`} class="block relative z-10">
    <div class={project.data.thumbnail ? "flex justify-between gap-6 items-start" : ""}>
      <div class="flex-1 min-w-0">
        <div class="text-xs mb-1 ui-p-accent uppercase">
          {formatDate(project.data.date)}
          {project.data.endDate && ` - ${formatDate(project.data.endDate)}`}
        </div>
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <h3 class="ui-heading-md mb-0.5">{project.data.title}</h3>
            {
              project.data.private && (
                <span class="px-2 py-1 text-xs font-medium text-amber-300" aria-label="Private project">
                  <Icon name="mdi:lock" class="w-4 h-4" />
                </span>
              )
            }
          </div>
        </div>
        <p class="text-sm ui-p mb-4">{project.data.description}</p>
        <slot />
        {
          project.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag) => (
                <span class="ui-tag blue">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
      {
        project.data.thumbnail && (
          <div class="flex-shrink-0 ml-4 max-w-[120px] w-full">
            <img
              src={project.data.thumbnail}
              alt={project.data.title + " image"}
              class="rounded-md object-cover w-full h-auto"
              loading="lazy"
            />
          </div>
        )
      }
    </div>
  </a>
</article>

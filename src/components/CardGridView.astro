---
import { Icon } from "astro-icon/components";

import { formatProjectDate, getProjectThumbnail, PROJECT_THUMBNAIL_PLACEHOLDER } from "../data/projects";
import type { Project } from "../data/projects";

const { project } = Astro.props as { project: Project };
const thumbnailUrl = getProjectThumbnail(project) || PROJECT_THUMBNAIL_PLACEHOLDER;
const date = formatProjectDate(project.data.date);
---

<article class="group relative min-w-0">
  <div class="project-hover-surface"></div>

  <a href={`/projects/${project.id}`} class="relative z-10 block">
    <div
      class="mb-5 aspect-video overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700/50 dark:bg-slate-800"
    >
      <img
        src={thumbnailUrl}
        alt={project.data.title + " image"}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]"
        loading="lazy"
      />
    </div>

    <div class="flex items-center justify-between text-sm text-slate-600 dark:text-slate-300">
      <span>{date}</span>
      {
        project.data.private && (
          <span class="inline-flex items-center gap-1 text-amber-600 dark:text-amber-300" aria-label="Private project">
            <Icon name="mdi:lock" class="h-3.5 w-3.5" />
            Private
          </span>
        )
      }
    </div>

    <div class="mt-2 flex items-start justify-between gap-3">
      <h3 class="project-title">
        {project.data.title}
        <Icon name="mdi:arrow-top-right" aria-hidden="true" class="project-title-arrow" />
      </h3>
    </div>

    <p class="project-description mt-2 min-h-[4rem]">
      {project.data.description}
    </p>

    {
      project.data.tags.length > 0 && (
        <div class="ui-divider mt-4 flex flex-wrap gap-2 border-t pt-3">
          {project.data.tags.map((tag) => (
            <span class="ui-tag blue">{tag}</span>
          ))}
        </div>
      )
    }
  </a>
</article>

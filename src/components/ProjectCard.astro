---
import type { Project } from "../types";

const props = Astro.props as { project: Project };
const { project } = props;
---

<article
  class="p-7 transition border group rounded-xl border-slate-200 bg-white/90 hover:shadow-xl hover:shadow-slate-200/50 dark:border-slate-200/5 dark:bg-white/5 dark:hover:shadow-slate-900/50"
  data-title={project.title}
  data-p={project.description}
  data-type={project.type}
  data-tags={project.tags.join(",")}
  data-access={project.private ? "private" : "public"}
  data-featured={project.featured ? "true" : "false"}
>
  <a href={`/projects/${project.slug}`} class="block">
    <div class="flex items-center justify-between mb-4">
      <h3 class="ui-heading-md mb-0.5">{project.title}</h3>
    </div>

    <p class="mt-3 mb-4 ui-p">{project.description}</p>

    <div class="flex flex-wrap gap-2 mb-5">
      {
        project.tags.map((tag) => (
          <span class="px-2 py-1 text-xs rounded bg-slate-100 text-slate-700 dark:bg-slate-800/50 dark:text-slate-200 border border-slate-200 dark:border-slate-700">
            {tag}
          </span>
        ))
      }
    </div>

    <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-800">
      <div class="inline-flex items-center gap-2 text-sm">
        {
          project.private ? (
            <>
              <i class="text-sm fa-solid fa-lock text-amber-600 dark:text-amber-300" aria-hidden="true" />
              <span class="text-amber-600 dark:text-amber-300">Private</span>
            </>
          ) : (
            <span class="text-slate-500 dark:text-slate-400">Public</span>
          )
        }
        <span class="mx-1 text-slate-400 dark:text-slate-500">&middot;</span>
        {project.featured && <span class="text-indigo-700 dark:text-indigo-400">Featured</span>}
        {project.featured && <span class="mx-1 text-slate-400 dark:text-slate-500">&middot;</span>}
        <span class="capitalize font-medium text-blue-600 dark:text-blue-400">{project.type}</span>
      </div>
      <div class="text-xs text-slate-400 dark:text-slate-500">
        {new Date(project.date).toLocaleDateString("en-US", { year: "numeric", month: "short" })}
      </div>
    </div>
  </a>
</article>

---
import { Icon } from "astro-icon/components";

const props = Astro.props;
const { href, label } = props as { href: string; label: string };
---

<div class="mb-8">
  <a
    href={href}
    class="group inline-flex items-center gap-2 text-base font-medium text-slate-900 underline decoration-slate-300 underline-offset-4 transition-colors hover:decoration-current dark:text-white dark:decoration-slate-600"
  >
    <Icon name="mdi:arrow-left" class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
    <span>{label}</span>
  </a>
</div>

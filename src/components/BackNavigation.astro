---
import { Icon } from "astro-icon/components";

const props = Astro.props;
const { href, label } = props as { href: string; label: string };
---

<div class="mb-8">
  <a
    href={href}
    class="inline-flex items-center gap-2 font-medium text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors group text-base"
  >
    <Icon name="mdi:arrow-left" class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
    <span>{label}</span>
  </a>
</div>

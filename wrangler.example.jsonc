{
  "main": "dist/_worker.js/index.js",
  "name": "portfolio",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "ACCESS_CODES",
      "id": "ENTER_YOUR_KV_NAMESPACE_ID_HERE",
      "remote": true,
    },
  ],
}
